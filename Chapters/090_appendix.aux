\@writefile{lof}{\contentsline {figure}{\numberline {A.1}{\ignorespaces 3D Renderings of DRO 02 sequence, timstamp 000. All models have been trained on 1000 ROIs with masked loss. a: original image, b: Mediar3D + ext. pretraining (0.72 SEG), c: Mediar3D + SAM2 Encoder (0.72 SEG), d: Mediar3D + paper weights (0.78 SEG). Artifacts in this prediction are probably due to clipping edges from manual image cropping around the primordium, done by the challenge authors for smaller file sizes.}}{xi}{figure.caption.77}\protected@file@percent }
\newlabel{fig:DRO_3D_VIS}{{A.1}{xi}{3D Renderings of DRO 02 sequence, timstamp 000. All models have been trained on 1000 ROIs with masked loss. a: original image, b: Mediar3D + ext. pretraining (0.72 SEG), c: Mediar3D + SAM2 Encoder (0.72 SEG), d: Mediar3D + paper weights (0.78 SEG). Artifacts in this prediction are probably due to clipping edges from manual image cropping around the primordium, done by the challenge authors for smaller file sizes}{figure.caption.77}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.2}{\ignorespaces Z-slice 52 prediction overlays of DRO 02 sequence, timstamp 000. All models have been trained on 1000 ROIs with masked loss. a: original image, b: Mediar3D + ext. pretraining (0.72 SEG), c: Mediar3D + SAM2 Encoder (0.72 SEG), d: Mediar3D + paper weights (0.78 SEG). Artifacts in this prediction are probably due to clipping edges from manual image cropping around the primordium, done by the challenge authors for smaller file sizes.}}{xii}{figure.caption.78}\protected@file@percent }
\newlabel{fig:DRO_2D_Vis}{{A.2}{xii}{Z-slice 52 prediction overlays of DRO 02 sequence, timstamp 000. All models have been trained on 1000 ROIs with masked loss. a: original image, b: Mediar3D + ext. pretraining (0.72 SEG), c: Mediar3D + SAM2 Encoder (0.72 SEG), d: Mediar3D + paper weights (0.78 SEG). Artifacts in this prediction are probably due to clipping edges from manual image cropping around the primordium, done by the challenge authors for smaller file sizes}{figure.caption.78}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.3}{\ignorespaces Zeroshot predictions on z-slice 52 of DRO 02 sequence, timstamp 000. a: Original Image, b: Mediar3D + ext. pretraining (0.74 SEG), c: Mediar3D + SAM2 Encoder (0.66 SEG), d: Mediar3D + paper weights (0.78 SEG), e: CellposeSAM (No SEG, as SEG is calculated as average from all labeled instances across all timestamps in the 02 sequence. Predicting all timestamps in the 02 sequence would be too expensive due to high inference time for CellposeSAM).}}{xiii}{figure.caption.79}\protected@file@percent }
\newlabel{fig:DRO_2D_zeroshot_Vis}{{A.3}{xiii}{Zeroshot predictions on z-slice 52 of DRO 02 sequence, timstamp 000. a: Original Image, b: Mediar3D + ext. pretraining (0.74 SEG), c: Mediar3D + SAM2 Encoder (0.66 SEG), d: Mediar3D + paper weights (0.78 SEG), e: CellposeSAM (No SEG, as SEG is calculated as average from all labeled instances across all timestamps in the 02 sequence. Predicting all timestamps in the 02 sequence would be too expensive due to high inference time for CellposeSAM)}{figure.caption.79}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.4}{\ignorespaces Prediction overlay on z-slice 12 of TRIC 02 sequence, timstamp 001. Mediar3D + ext. pretraining: 0.81 SEG @10 ROIs finetuning, Mediar3D + SAM2 Encoder: 0.65 SEG @10,000 ROIs finetuning, Mediar3D + paper weights 0.81 SEG @10,000 ROIs finetuning}}{xiv}{figure.caption.80}\protected@file@percent }
\newlabel{fig:TRIC_2D_slices.png}{{A.4}{xiv}{Prediction overlay on z-slice 12 of TRIC 02 sequence, timstamp 001. Mediar3D + ext. pretraining: 0.81 SEG @10 ROIs finetuning, Mediar3D + SAM2 Encoder: 0.65 SEG @10,000 ROIs finetuning, Mediar3D + paper weights 0.81 SEG @10,000 ROIs finetuning}{figure.caption.80}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.5}{\ignorespaces BlastoSPIM result images, 3D rendered predictions overlayed with original image. Left column: 'Blast\_F2\_008', Right column: 'Blast\_H1\_009'. model finetuning ROI stages and thresholds were manually selected for best case per model.}}{xv}{figure.caption.81}\protected@file@percent }
\newlabel{fig:BlastoResults.png}{{A.5}{xv}{BlastoSPIM result images, 3D rendered predictions overlayed with original image. Left column: 'Blast\_F2\_008', Right column: 'Blast\_H1\_009'. model finetuning ROI stages and thresholds were manually selected for best case per model}{figure.caption.81}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {A.6}{\ignorespaces Synthetic CTC result images, 3D rendered predictions overlayed with original image. All models were trained on 100000 ROIs at were evaluated on a cellprobability threshold of 0.5. As statistics of the 01 and 02 sequences correlate a lot, all models achieved SEG scores around 0.85-0.90. }}{xvi}{figure.caption.82}\protected@file@percent }
\newlabel{fig:SimResults.png}{{A.6}{xvi}{Synthetic CTC result images, 3D rendered predictions overlayed with original image. All models were trained on 100000 ROIs at were evaluated on a cellprobability threshold of 0.5. As statistics of the 01 and 02 sequences correlate a lot, all models achieved SEG scores around 0.85-0.90}{figure.caption.82}{}}
